# Hardware design files (Altium CAD project — large/binary, not tracked)
# Leading slash anchors this to the repo root. Unanchored it matched at any
# depth, which silently excluded the firmware's src/hardware/ directory too
# (git is case-insensitive on Windows).
/Hardware/

# PlatformIO (firmware)
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Python
.venv/
__pycache__/
*.pyc

# Node / web app
node_modules/
dist/

# Graphify knowledge-graph output (regenerable cache)
graphify-out/

# Claude Code local settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
